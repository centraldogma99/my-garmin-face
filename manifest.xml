<?xml version="1.0"?>
<iq:manifest xmlns:iq="http://www.garmin.com/xml/connectiq" version="3">
    <iq:application
        id="b269ae33f5b343628269f59b7f2699b2"
        type="watchface"
        name="@Strings.AppName"
        entry="ReconApp"
        launcherIcon="@Drawables.LauncherIcon"
        minApiLevel="3.2.0">

        <!-- Round displays only: the layout is polar around the bezel.
             Trimmed to the Forerunner 265 family; add more <iq:product> ids
             here as you install their device packages in the SDK Manager. -->
        <iq:products>
            <iq:product id="fr265"/>   <!-- 416 x 416 -->
            <iq:product id="fr265s"/>  <!-- 360 x 360 -->
        </iq:products>

        <iq:permissions>
            <iq:uses-permission id="SensorHistory"/>
            <iq:uses-permission id="UserProfile"/>
        </iq:permissions>

        <iq:languages>
            <iq:language>eng</iq:language>
            <iq:language>kor</iq:language>
        </iq:languages>
    </iq:application>
</iq:manifest>
